rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /userAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['householdId', 'homeHouseholdId'])
        && request.resource.data.householdId == uid
        && request.resource.data.homeHouseholdId == uid
        && existsAfter(/databases/$(database)/documents/kitchen/$(uid))
        && getAfter(/databases/$(database)/documents/kitchen/$(uid)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/kitchen/$(uid)).data.members[uid] == 'owner';
      allow update, delete: if false;
    }

    match /kitchen/{householdId} {
      allow read: if isMember(householdId) || isInitializingPersonalHousehold(householdId);
      allow create: if canCreatePersonalHousehold(householdId);
      allow update: if isMember(householdId)
        && validSettings(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reminderEnabled',
          'reminderHour',
          'timeZone',
          'budgetAlertsEnabled',
          'discretionaryCategories',
          'memberProfiles'
        ])
        && validOwnMemberProfileUpdate();
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && validItem(request.resource.data)
          && !request.resource.data.keys().hasAny(['deletedAt']);
        allow update: if isMember(householdId) && validItem(request.resource.data)
          && (
            (!resource.data.keys().hasAny(['deletedAt'])
              && (!request.resource.data.keys().hasAny(['deletedAt'])
                || (request.resource.data.deletedAt == request.time
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'updatedAt']))))
            || (resource.data.keys().hasAny(['deletedAt'])
              && request.time < resource.data.deletedAt + duration.value(60, 's')
              && !request.resource.data.keys().hasAny(['deletedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'updatedAt']))
          );
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt', 'uid'])
          && request.resource.data.keys().hasAll(['platform', 'updatedAt'])
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
        allow update: if isMember(householdId)
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt', 'uid'])
          && request.resource.data.keys().hasAll(['platform', 'updatedAt'])
          && request.resource.data.platform in ['ios', 'android']
          && (
            request.resource.data.uid == request.auth.uid
            || (
              isKitchenOwner(householdId)
              && !resource.data.keys().hasAny(['uid'])
              && !request.resource.data.keys().hasAny(['uid'])
            )
          )
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isMember(householdId)
          && (
            resource.data.uid == request.auth.uid
            || (isKitchenOwner(householdId) && !resource.data.keys().hasAny(['uid']))
          );
      }

      match /receipts/{receiptId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId) && validReceipt(request.resource.data);
        allow delete: if isMember(householdId);
      }

      match /budgets/{budgetId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && validBudget(request.resource.data)
          && !request.resource.data.keys().hasAny(['alertState']);
        allow update: if isMember(householdId)
          && validBudget(request.resource.data)
          && (
            (!request.resource.data.keys().hasAny(['alertState'])
              && !resource.data.keys().hasAny(['alertState']))
            || (
              request.resource.data.keys().hasAny(['alertState'])
              && resource.data.keys().hasAny(['alertState'])
              && request.resource.data.alertState == resource.data.alertState
            )
          );
        allow delete: if isMember(householdId);
      }

      match /alerts/{alertId} {
        allow read: if isMember(householdId);
        allow create: if false;
        allow update: if isMember(householdId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if isMember(householdId);
      }

      match /insights/{insightId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      match /usage/{usageId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      match /memberSettings/{uid} {
        allow read: if isMember(householdId) && request.auth.uid == uid;
        allow create, update: if isMember(householdId)
          && request.auth.uid == uid
          && validMemberSettings(request.resource.data);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isMember(householdId) {
      return (
          request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/userAccounts/$(request.auth.uid))
          && get(/databases/$(database)/documents/userAccounts/$(request.auth.uid)).data.householdId == householdId
          && exists(/databases/$(database)/documents/kitchen/$(householdId))
          && get(/databases/$(database)/documents/kitchen/$(householdId)).data.members is map
          && request.auth.uid in get(/databases/$(database)/documents/kitchen/$(householdId)).data.members.keys()
          && get(/databases/$(database)/documents/kitchen/$(householdId)).data.members[request.auth.uid] in ['owner', 'member']
        );
    }

    function isInitializingPersonalHousehold(householdId) {
      return request.auth != null
        && request.auth.uid == householdId
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/userAccounts/$(request.auth.uid));
    }

    function canCreatePersonalHousehold(householdId) {
      return request.auth != null
        && request.auth.uid == householdId
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && validSettings(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.memberProfiles is map
        && request.resource.data.memberProfiles.keys().hasOnly([request.auth.uid])
        && existsAfter(/databases/$(database)/documents/userAccounts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/userAccounts/$(request.auth.uid)).data.householdId == householdId
        && getAfter(/databases/$(database)/documents/userAccounts/$(request.auth.uid)).data.homeHouseholdId == householdId;
    }

    function isKitchenOwner(householdId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/userAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccounts/$(request.auth.uid)).data.householdId == householdId
        && exists(/databases/$(database)/documents/kitchen/$(householdId))
        && get(/databases/$(database)/documents/kitchen/$(householdId)).data.members is map
        && get(/databases/$(database)/documents/kitchen/$(householdId)).data.members[request.auth.uid] == 'owner';
    }

    function validSettings(data) {
      return data.keys().hasOnly([
          'reminderEnabled',
          'reminderHour',
          'timeZone',
          'budgetAlertsEnabled',
          'discretionaryCategories',
          'ownerUid',
          'members',
          'memberProfiles'
        ])
        && data.reminderEnabled is bool
        && data.reminderHour is int
        && data.reminderHour >= 0
        && data.reminderHour <= 23
        && data.timeZone is string
        && data.budgetAlertsEnabled is bool
        && data.discretionaryCategories is list
        && (!data.keys().hasAny(['ownerUid']) || data.ownerUid is string)
        && (!data.keys().hasAny(['members']) || data.members is map)
        && (!data.keys().hasAny(['memberProfiles']) || data.memberProfiles is map);
    }

    function validOwnMemberProfileUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberProfiles'])
        || (
          request.resource.data.memberProfiles is map
          && resource.data.memberProfiles is map
          && request.resource.data.memberProfiles.diff(resource.data.memberProfiles)
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberProfiles[request.auth.uid] is map
          && request.resource.data.memberProfiles[request.auth.uid].keys().hasOnly(['displayName', 'photoURL'])
          && request.resource.data.memberProfiles[request.auth.uid].displayName is string
          && request.resource.data.memberProfiles[request.auth.uid].photoURL is string
        );
    }

    function validMemberSettings(data) {
      return data.keys().hasOnly([
          'reminderEnabled',
          'reminderHour',
          'expiryWarnDays',
          'budgetAlertsEnabled',
          'weeklySummaryEnabled',
          'language',
          'theme',
          'diet',
          'dislikes',
          'servings',
          'maxCookingTimeMinutes',
          'createdAt',
          'updatedAt'
        ])
        && data.reminderEnabled is bool
        && data.reminderHour is int
        && data.reminderHour >= 0
        && data.reminderHour <= 23
        && data.expiryWarnDays is int
        && data.expiryWarnDays >= 0
        && data.expiryWarnDays <= 30
        && data.budgetAlertsEnabled is bool
        && data.weeklySummaryEnabled is bool
        && data.language is string
        && data.theme in ['system', 'light', 'dark']
        && data.diet is list
        && data.dislikes is list
        && data.servings is int
        && data.servings >= 1
        && data.servings <= 20
        && data.maxCookingTimeMinutes is int
        && data.maxCookingTimeMinutes >= 1
        && data.maxCookingTimeMinutes <= 600;
    }

    function validItem(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.quantity is number
        && data.quantity >= 0
        && data.quantity <= 9999
        && (!data.keys().hasAny(['stockBaseline']) || (data.stockBaseline is number
          && data.stockBaseline >= 0 && data.stockBaseline <= 9999))
        && data.category is string
        && data.state in ['inStock', 'finished', 'toBuy']
        && (!data.keys().hasAny(['bought']) || data.bought is bool)
        && (!data.keys().hasAny(['boughtAt']) || data.boughtAt == null || data.boughtAt is timestamp)
        && (!data.keys().hasAny(['receiptRecorded']) || data.receiptRecorded is bool)
        && (!data.keys().hasAny(['deletedAt']) || data.deletedAt is timestamp);
    }

    function validReceipt(data) {
      return data.storeName is string
        && data.storeName.size() <= 100
        && data.totalCents is int
        && data.lineItems is list
        && data.lineItems.size() <= 200
        && data.purchaseDateKey is string
        && data.purchaseDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.currency == 'EUR';
    }

    function validBudget(data) {
      return data.keys().hasOnly([
          'name',
          'period',
          'amountCents',
          'scope',
          'active',
          'alertState',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.amountCents is int
        && data.amountCents > 0
        && data.period in ['weekly', 'monthly']
        && data.scope is map
        && validBudgetScope(data.scope)
        && data.active is bool;
    }

    function validBudgetScope(scope) {
      return scope.keys().hasOnly(['type', 'categories'])
        && (
          (scope.type == 'overall' && !scope.keys().hasAny(['categories']))
          || (
            scope.type == 'categories'
            && scope.categories is list
            && scope.categories.size() > 0
            && scope.categories.size() <= 10
            && scope.categories.hasOnly([
              'Groceries',
              'Beverages',
              'Cafe & Eating out',
              'Snacks & Sweets',
              'Alcohol',
              'Tobacco',
              'Household',
              'Drugstore & Personal care',
              'Deposit/Pfand',
              'Other'
            ])
          )
          || (
            scope.type == 'discretionary'
            && !scope.keys().hasAny(['categories'])
          )
        );
    }
  }
}
