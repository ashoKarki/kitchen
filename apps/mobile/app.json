{
  "expo": {
    "name": "My Kitchen",
    "slug": "my-kitchen",
    "scheme": "mykitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "imageWidth": 300,
      "resizeMode": "contain",
      "backgroundColor": "#f5f8f2"
    },
    "ios": {
      "bundleIdentifier": "com.ashokkarki.mykitchen",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#f5f8f2"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#31835d",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Kitchen to select a receipt image for scanning.",
          "cameraPermission": "Allow My Kitchen to photograph a receipt for scanning."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow My Kitchen to photograph a receipt for scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2487053a-5d9e-46fe-9f15-128d25a99818"
      }
    },
    "owner": "ashok_karki",
    "android": {
      "package": "com.ashokkarki.mykitchen",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f8f2"
      }
    }
  }
}
